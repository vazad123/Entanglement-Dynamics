Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Drop", "[", "nois90", "]"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Red"}]}], "]"}], ",", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"a", " ", 
        SqrtBox["x"]}], "+", 
       RowBox[{"b", " ", 
        SuperscriptBox["x", 
         RowBox[{"1", "/", "3"}]]}], "+", 
       RowBox[{"c", " ", "x"}], "+", 
       RowBox[{"d", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "e"}], " ", "x"}], "]"}]}]}], "/.", "\[VeryThinSpace]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a", "\[Rule]", 
         RowBox[{"-", "0.21746387410412107`"}]}], ",", 
        RowBox[{"b", "\[Rule]", "0.7069868369191148`"}], ",", 
        RowBox[{"c", "\[Rule]", 
         RowBox[{"-", "0.0008606242213454921`"}]}], ",", 
        RowBox[{"d", "\[Rule]", 
         RowBox[{"-", "0.6143446138754819`"}]}], ",", 
        RowBox[{"e", "\[Rule]", "0.34660560292088294`"}]}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "200"}], "}"}], ",", 
     RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.76006983284825*^9, 3.760069851906052*^9}, {
  3.760069941487212*^9, 3.760069941753255*^9}},
