Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ListPlot", "[", 
    RowBox[{"nois90", ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Red"}]}], "]"}], ",", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"a", " ", 
        SqrtBox["x"]}], "+", 
       RowBox[{"b", " ", 
        SuperscriptBox["x", 
         RowBox[{"1", "/", "3"}]]}], "+", 
       RowBox[{"c", " ", "x"}], "+", 
       RowBox[{"d", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "e"}], " ", "x"}], "]"}]}]}], "/.", "\[VeryThinSpace]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a", "\[Rule]", "0.19915885623069984`"}], ",", 
        RowBox[{"b", "\[Rule]", "0.1610559570980988`"}], ",", 
        RowBox[{"c", "\[Rule]", 
         RowBox[{"-", "0.019705430897474997`"}]}], ",", 
        RowBox[{"d", "\[Rule]", 
         RowBox[{"-", "0.8481544626434205`"}]}], ",", 
        RowBox[{"e", "\[Rule]", "0.9412876721450883`"}]}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "1", ",", "90"}], "}"}]}], "]"}]}], "]"}]], "Input",
