Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ListPlot", "[", 
    RowBox[{"nois90", ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Red"}]}], "]"}], ",", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"a", " ", 
        SqrtBox["x"]}], "+", 
       RowBox[{"b", " ", 
        SuperscriptBox["x", 
         RowBox[{"1", "/", "3"}]]}], "+", 
       RowBox[{"c", " ", "x"}], "+", 
       RowBox[{"d", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "d"}], " ", "x"}], "]"}]}]}], "/.", "\[VeryThinSpace]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a", "\[Rule]", "0.6956677983003448`"}], ",", 
        RowBox[{"b", "\[Rule]", 
         RowBox[{"-", "0.4356557774779859`"}]}], ",", 
        RowBox[{"c", "\[Rule]", 
         RowBox[{"-", "0.04748197849625604`"}]}], ",", 
        RowBox[{"d", "\[Rule]", 
         RowBox[{"-", "0.01634461738947615`"}]}]}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "1", ",", "40"}], "}"}]}], "]"}]}], "]"}]], "Input",
