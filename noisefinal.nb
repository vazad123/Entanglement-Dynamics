        RowBox[{"e", "\[Rule]", "1.1915442625237795`"}]}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "1", ",", "40"}], "}"}]}], "]"}]}], "]"}]], "Input",
