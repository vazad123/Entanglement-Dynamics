Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ListPlot", "[", 
    RowBox[{"nois90", ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Red"}]}], "]"}], ",", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"a", " ", 
        SqrtBox["x"]}], "+", 
       RowBox[{"b", " ", 
        SuperscriptBox["x", 
         RowBox[{"1", "/", "3"}]]}], "+", 
       RowBox[{"c", " ", "x"}], "+", 
       RowBox[{"d", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "e"}], " ", "x"}], "]"}]}]}], "/.", "\[VeryThinSpace]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a", "\[Rule]", "0.5534801177708996`"}], ",", 
        RowBox[{"b", "\[Rule]", 
         RowBox[{"-", "0.253046328553623`"}]}], ",", 
        RowBox[{"c", "\[Rule]", 
         RowBox[{"-", "0.04221626470528879`"}]}], ",", 
        RowBox[{"d", "\[Rule]", 
         RowBox[{"-", "2.579072302505343`"}]}], ",", 
        RowBox[{"e", "\[Rule]", "2.3031720397360282`"}]}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "1", ",", "30"}], "}"}]}], "]"}]}], "]"}]], "Input",
