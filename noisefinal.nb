Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"Drop", "[", 
      RowBox[{"nois90", ",", 
       RowBox[{"-", "160"}]}], "]"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Red"}]}], "]"}], ",", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"a", " ", 
        SqrtBox["x"]}], "+", 
       RowBox[{"b", " ", 
        SuperscriptBox["x", 
         RowBox[{"1", "/", "3"}]]}], "+", 
       RowBox[{"c", " ", "x"}], "+", 
       RowBox[{"d", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "e"}], " ", "x"}], "]"}]}]}], "/.", "\[VeryThinSpace]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a", "\[Rule]", "0.31210417387548667`"}], ",", 
        RowBox[{"b", "\[Rule]", "0.025982112242386838`"}], ",", 
        RowBox[{"c", "\[Rule]", 
         RowBox[{"-", "0.026407427183689405`"}]}], ",", 
        RowBox[{"d", "\[Rule]", 
